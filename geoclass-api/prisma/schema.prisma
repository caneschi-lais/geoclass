generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String    @id @default(uuid())
  name                      String
  email                     String    @unique
  password_hash             String
  role                      Role      @default(ALUNO)
  ra                        String?   @unique
  courses                   String[]  @default([]) // Lista de cursos vinculados
  student_semester          String?   // Ex: "6º Semestre" (legado / padrão)
  active                    Boolean   @default(true)
  privacy_terms_accepted_at DateTime?

  userCourses   UserCourse[]
  classesTaught Class[]        @relation("ProfessorClasses")
  enrollments   Enrollment[]
  attendances   Attendance[]
  notifications Notification[]

  created_at DateTime @default(now())
}

model UserCourse {
  id           String  @id @default(uuid())
  user_id      String
  user         User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course_name  String
  semester     String? // Ex: "6º Semestre"
  is_completed Boolean @default(false) // Indica se o aluno ja concluiu este curso

  @@unique([user_id, course_name])
}

model Class {
  id            String  @id @default(uuid())
  subject       String
  course_name   String? @default("Análise e Desenvolvimento de Sistemas") // Ex: "Análise e Desenvolvimento de Sistemas"
  schedule_time String // Ex: "08:00"
  week_days     String? // Ex: "segunda", "terca,quarta", "quinta"
  latitude      Float
  longitude     Float
  radius_meters Int
  active        Boolean @default(true)

  semester      String @default("2026.1") // Ex: "2026.1"
  room_name     String @default("Sala Padrão") // Ex: "Lab 1"
  total_classes Int    @default(40) // Quantidade total de aulas previstas

  professor_id String
  professor    User   @relation("ProfessorClasses", fields: [professor_id], references: [id])

  enrollments Enrollment[]
  attendances Attendance[]

  created_at    DateTime                 @default(now())
  temporaryLocs TemporaryClassLocation[]
}

model Enrollment {
  id String @id @default(uuid())

  student_id String
  student    User   @relation(fields: [student_id], references: [id], onDelete: Cascade)

  class_id String
  class    Class  @relation(fields: [class_id], references: [id], onDelete: Cascade)

  is_completed Boolean @default(false) // Indica se o aluno concluiu esta matéria específica

  @@unique([student_id, class_id])
}

model Attendance {
  id String @id @default(uuid())

  student_id String
  student    User   @relation(fields: [student_id], references: [id])

  class_id String
  class    Class  @relation(fields: [class_id], references: [id])

  date          DateTime @db.Date
  slot_time     String?  // Ex: "19:00", "19:50", "20:50", "21:40"
  check_in_time DateTime
  device_id     String?
  status        Status   @default(PRESENTE)

  student_latitude  Float?
  student_longitude Float?

  is_remote         Boolean @default(false)
  manual_attendance Boolean @default(false)

  created_at DateTime @default(now())

  @@unique([student_id, class_id, date, slot_time])
}

enum Role {
  ALUNO
  PROFESSOR
  COORDENADOR
}

enum Status {
  PRESENTE
  ATRASADO
  FALTA
}

model Room {
  id        String @id @default(uuid())
  name      String @unique
  latitude  Float
  longitude Float
}

model TemporaryClassLocation {
  id        String @id @default(uuid())
  class_id  String
  class     Class  @relation(fields: [class_id], references: [id])
  date      String // Ex: "2026-05-12"
  room_id   String
  room_name String
  latitude  Float
  longitude Float

  @@unique([class_id, date])
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String
  body       String
  read       Boolean  @default(false)
  created_at DateTime @default(now())
}
