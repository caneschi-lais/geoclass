generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        Int       @id @default(autoincrement())
  name                      String
  email                     String    @unique
  password_hash             String
  role                      Role      @default(ALUNO)
  ra                        String?   @unique
  courses                   String[]  @default([]) // Lista de cursos vinculados
  student_semester          String?   // Ex: "6º Semestre" (legado / padrão)
  active                    Boolean   @default(true)
  privacy_terms_accepted_at DateTime?
  push_token                String?

  userCourses   UserCourse[]
  classesTaught Class[]             @relation("ProfessorClasses")
  enrollments   Enrollment[]
  attendances   Attendance[]
  notifications Notification[]
  cancellations ClassCancellation[] @relation("ProfessorCancellations")

  created_at DateTime @default(now())
}

model UserCourse {
  id           Int     @id @default(autoincrement())
  user_id      Int
  user         User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course_name  String
  semester     String? // Ex: "6º Semestre"
  is_completed Boolean @default(false) // Indica se o aluno ja concluiu este curso

  @@unique([user_id, course_name])
}

model Class {
  id            Int     @id @default(autoincrement())
  subject       String
  course_name   String? @default("Análise e Desenvolvimento de Sistemas") // Ex: "Análise e Desenvolvimento de Sistemas"
  schedule_time String  // Ex: "08:00"
  week_days     String? // Ex: "segunda", "terca,quarta", "quinta"
  latitude      Float
  longitude     Float
  radius_meters Int
  active        Boolean @default(true)

  semester      String @default("2026.1") // Ex: "2026.1"
  room_name     String @default("Sala Padrão") // Ex: "Lab 1"
  total_classes Int    @default(40) // Quantidade total de aulas previstas

  professor_id Int
  professor    User   @relation("ProfessorClasses", fields: [professor_id], references: [id])

  enrollments   Enrollment[]
  attendances   Attendance[]
  temporaryLocs TemporaryClassLocation[]
  cancellations ClassCancellation[]

  created_at DateTime @default(now())
}

model Enrollment {
  id Int @id @default(autoincrement())

  student_id Int
  student    User   @relation(fields: [student_id], references: [id], onDelete: Cascade)

  class_id Int
  class    Class  @relation(fields: [class_id], references: [id], onDelete: Cascade)

  is_completed Boolean @default(false) // Indica se o aluno concluiu esta matéria específica

  @@unique([student_id, class_id])
}

model Attendance {
  id Int @id @default(autoincrement())

  student_id Int
  student    User   @relation(fields: [student_id], references: [id])

  class_id Int
  class    Class  @relation(fields: [class_id], references: [id])

  date          DateTime @db.Date
  slot_time     String?  // Ex: "19:00", "19:50", "20:50", "21:40"
  check_in_time DateTime
  device_id     String?
  status        Status   @default(PRESENTE)

  student_latitude  Float?
  student_longitude Float?

  is_remote         Boolean @default(false)
  manual_attendance Boolean @default(false)

  created_at DateTime @default(now())

  @@unique([student_id, class_id, date, slot_time])
}

enum Role {
  ALUNO
  PROFESSOR
  COORDENADOR
}

enum Status {
  PRESENTE
  ATRASADO
  FALTA
  PRESENCA_PARCIAL
}

model Room {
  id            Int                      @id @default(autoincrement())
  name          String                   @unique
  latitude      Float
  longitude     Float
  temporaryLocs TemporaryClassLocation[]
}

model TemporaryClassLocation {
  id        Int     @id @default(autoincrement())
  class_id  Int
  class     Class   @relation(fields: [class_id], references: [id])
  date      String  // Ex: "2026-05-12"
  room_id   Int?
  room      Room?   @relation(fields: [room_id], references: [id])
  room_name String
  latitude  Float
  longitude Float

  @@unique([class_id, date])
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String
  body       String
  read       Boolean  @default(false)
  created_at DateTime @default(now())
}

model AcademicCalendar {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date @unique
  description String
  type        String   @default("NAO_LETIVO") // "FERIADO", "RECESSO", "NAO_LETIVO", "EXAME", "SPAP"
  created_at  DateTime @default(now())
}

model AcademicSemester {
  id         Int      @id @default(autoincrement())
  name       String   @unique // Ex: "2026.1", "2026.2"
  start_date DateTime @db.Date // Início das aulas (ex: 2026-02-09)
  end_date   DateTime @db.Date // Término das aulas (ex: 2026-06-27)
  active     Boolean  @default(true)
  created_at DateTime @default(now())
}

model ClassCancellation {
  id                    Int       @id @default(autoincrement())
  class_id              Int?
  class                 Class?    @relation(fields: [class_id], references: [id], onDelete: Cascade)
  course_name           String?   // Para cancelamentos por curso
  professor_id          Int?
  professor             User?     @relation("ProfessorCancellations", fields: [professor_id], references: [id])
  date                  DateTime  @db.Date
  reason_type           String    // "SAUDE", "PESSOAL", "ACADEMICO", "TRANSPORTE", "MANUTENCAO", "FERIADO_EXTRA", "OUTROS"
  description           String?
  certificate_url       String?
  status                String    @default("PENDENTE") // "PENDENTE", "APROVADO", "REJEITADO"
  scope                 String    @default("TURMA")    // "TURMA", "CURSO", "INSTITUICAO"
  created_by_role       Role      @default(PROFESSOR)
  replacement_date      DateTime? @db.Date
  replacement_completed Boolean   @default(false)
  created_at            DateTime  @default(now())

  @@index([date])
  @@index([class_id, date])
}
