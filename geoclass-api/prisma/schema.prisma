generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        Int       @id @default(autoincrement())
  name                      String
  email                     String    @unique
  password_hash             String
  role                      Role      @default(ALUNO)
  ra                        String?   @unique
  active                    Boolean   @default(true)
  privacy_terms_accepted_at DateTime?
  push_token                String?

  userCourses   UserCourse[]
  classesTaught Class[]             @relation("ProfessorClasses")
  enrollments   Enrollment[]
  attendances   Attendance[]
  notifications Notification[]
  cancellations ClassCancellation[] @relation("ProfessorCancellations")

  created_at DateTime @default(now())
}

model Course {
  id            Int                 @id @default(autoincrement())
  name          String              @unique
  code          String?             @unique
  userCourses   UserCourse[]
  classes       Class[]
  cancellations ClassCancellation[]
  created_at    DateTime            @default(now())
}

model UserCourse {
  id           Int               @id @default(autoincrement())
  user_id      Int
  user         User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course_id    Int
  course       Course            @relation(fields: [course_id], references: [id], onDelete: Cascade)
  semester_id  Int?
  semester     AcademicSemester? @relation(fields: [semester_id], references: [id])
  student_term String?           // Ex: "6º Semestre" (semestre curricular do aluno)
  is_completed Boolean           @default(false)

  @@unique([user_id, course_id])
}

model Room {
  id            Int                      @id @default(autoincrement())
  name          String                   @unique
  latitude      Float
  longitude     Float
  classes       Class[]
  temporaryLocs TemporaryClassLocation[]
}

model AcademicSemester {
  id          Int                @id @default(autoincrement())
  name        String             @unique // Ex: "2026.1", "2026.2"
  start_date  DateTime           @db.Date
  end_date    DateTime           @db.Date
  active      Boolean            @default(true)
  classes     Class[]
  calendars   AcademicCalendar[]
  userCourses UserCourse[]
  created_at  DateTime           @default(now())
}

model AcademicCalendar {
  id          Int               @id @default(autoincrement())
  date        DateTime          @unique @db.Date
  description String
  type        String            @default("NAO_LETIVO") // "FERIADO", "RECESSO", "NAO_LETIVO", "EXAME", "SPAP"
  semester_id Int?
  semester    AcademicSemester? @relation(fields: [semester_id], references: [id])
  created_at  DateTime          @default(now())
}

model Class {
  id            Int     @id @default(autoincrement())
  subject       String
  schedule_time String  // Ex: "08:00"
  week_days     String? // Ex: "segunda", "terca,quarta", "quinta"
  radius_meters Int
  active        Boolean @default(true)
  total_classes Int     @default(40) // Quantidade total de aulas previstas

  room_id       Int
  room          Room    @relation(fields: [room_id], references: [id])

  course_id     Int?
  course        Course? @relation(fields: [course_id], references: [id])

  semester_id   Int
  semester      AcademicSemester @relation(fields: [semester_id], references: [id])

  professor_id  Int
  professor     User    @relation("ProfessorClasses", fields: [professor_id], references: [id])

  enrollments   Enrollment[]
  attendances   Attendance[]
  temporaryLocs TemporaryClassLocation[]
  cancellations ClassCancellation[]

  created_at DateTime @default(now())
}

model Enrollment {
  id Int @id @default(autoincrement())

  student_id Int
  student    User   @relation(fields: [student_id], references: [id], onDelete: Cascade)

  class_id Int
  class    Class  @relation(fields: [class_id], references: [id], onDelete: Cascade)

  is_completed Boolean @default(false)

  @@unique([student_id, class_id])
}

model Attendance {
  id Int @id @default(autoincrement())

  student_id Int
  student    User   @relation(fields: [student_id], references: [id])

  class_id Int
  class    Class  @relation(fields: [class_id], references: [id])

  date          DateTime @db.Date
  slot_time     String?  // Ex: "19:00", "19:50", "20:50", "21:40"
  check_in_time DateTime
  device_id     String?
  status        Status   @default(PRESENTE)

  student_latitude  Float?
  student_longitude Float?

  is_remote         Boolean @default(false)
  manual_attendance Boolean @default(false)

  created_at DateTime @default(now())

  @@unique([student_id, class_id, date, slot_time])
}

enum Role {
  ALUNO
  PROFESSOR
  COORDENADOR
}

enum Status {
  PRESENTE
  ATRASADO
  FALTA
  PRESENCA_PARCIAL
}

model TemporaryClassLocation {
  id       Int      @id @default(autoincrement())
  class_id Int
  class    Class    @relation(fields: [class_id], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  room_id  Int
  room     Room     @relation(fields: [room_id], references: [id])

  @@unique([class_id, date])
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String
  body       String
  read       Boolean  @default(false)
  created_at DateTime @default(now())
}

model ClassCancellation {
  id                    Int       @id @default(autoincrement())
  class_id              Int?
  class                 Class?    @relation(fields: [class_id], references: [id], onDelete: Cascade)
  course_id             Int?
  course                Course?   @relation(fields: [course_id], references: [id])
  professor_id          Int?
  professor             User?     @relation("ProfessorCancellations", fields: [professor_id], references: [id])
  date                  DateTime  @db.Date
  reason_type           String    // "SAUDE", "PESSOAL", "ACADEMICO", "TRANSPORTE", "MANUTENCAO", "FERIADO_EXTRA", "OUTROS"
  description           String?
  certificate_url       String?
  status                String    @default("PENDENTE") // "PENDENTE", "APROVADO", "REJEITADO"
  scope                 String    @default("TURMA")    // "TURMA", "CURSO", "INSTITUICAO"
  created_by_role       Role      @default(PROFESSOR)
  replacement_date      DateTime? @db.Date
  replacement_completed Boolean   @default(false)
  created_at            DateTime  @default(now())

  @@index([date])
  @@index([class_id, date])
}
