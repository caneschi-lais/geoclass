# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-[SUA-REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-[SUA-REGIAO].pooler.supabase.com:5432/postgres"

# Porta do Servidor
PORT=3000

# Chave secreta para assinatura dos tokens JWT (usada no AuthController e authMiddleware)
JWT_SECRET="sua_chave_secreta_jwt_forte_aqui"

# Chave secreta compartilhada para validação de assinaturas de presença offline
OFFLINE_SECRET="geoclass_offline_secret_key_2026"
